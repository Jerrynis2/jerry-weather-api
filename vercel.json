{
  "version": 2,
  "builds": [
    {
      "src": "api/*.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/weather", "dest": "/api/weather" },
    { "src": "/api/location", "dest": "/api/location" },
    { "src": "/api/health", "dest": "/api/health" }
  ],
  "functions": {
    "api/weather.ts": { "maxDuration": 10 },
    "api/location.ts": { "maxDuration": 10 },
    "api/health.ts": { "maxDuration": 5 }
  }
}
